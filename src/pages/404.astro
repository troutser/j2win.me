---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404">
  <h1>404 - Page Not Found</h1>
  <p>Sorry, the page you were looking for doesn't exist (or never did).</p>
  <p><a href={`${base}/`}>&laquo; Back to the home page</a></p>
</Base>
