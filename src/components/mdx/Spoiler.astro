---
/** Collapsible hint / solution for CTF-style posts: <Spoiler label="hint 1">Look at the headers.</Spoiler> */
interface Props {
  label?: string;
}
const { label = 'reveal solution' } = Astro.props;
---

<details class="spoiler">
  <summary>{label}</summary>
  <div class="body"><slot /></div>
</details>

<style>
  .spoiler {
    margin: 1em 0;
    padding: 4px 10px;
    border: 1px dashed var(--border);
  }
  summary {
    cursor: pointer;
    font-weight: bold;
  }
</style>
